# AuraPulse AI Music Platform Configuration

# Backend Port
PORT=5000

# MongoDB Connection String (leave default for local MongoDB or use Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_music

# YouTube Data API v3 Key (from Google Cloud Console)
# If empty, the app utilizes our resilient fallback YouTube scraper
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Google Gemini API Key (from Google AI Studio)
# If empty, the app utilizes our high-precision NLP heuristic mood & genre extractor
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

